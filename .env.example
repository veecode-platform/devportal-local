# Host port published for the DevPortal UI.
DEVPORTAL_PORT=7007

# Password used by the local PostgreSQL service and DevPortal.
POSTGRES_PASSWORD=rhdh

# Portal image override. The default is the digest of the image the pinned
# chart points at (the product as customers run it). Set this to
# veecode/devportal:edge to opt in to the next portal. latest is never a valid
# value; it is the 2.x line.
# DEVPORTAL_IMAGE=
